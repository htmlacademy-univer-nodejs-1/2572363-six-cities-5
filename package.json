{
  "name": "six-cities",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run build && node ./dist/main.rest.js",
    "start:dev": "npm run build && node ./dist/main.rest.js | pino-pretty",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "cli": "node ./dist/main.cli.js",
    "mock:server": "json-server ./mocks/mock-server-data.json --port 3123",
    "import:test": "node ./dist/main.cli.js --import ./mocks/mock-data.tsv ${DB_USER} ${DB_PASSWORD} ${DB_HOST} ${DB_PORT} ${DB_NAME} ${SALT}",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "if not exist .env copy .env.example .env && echo Edit .env file with your passwords"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "^6.0.6",
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "^1.0.0-beta.3",
    "pino-pretty": "^13.1.2",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "4.9.5"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "@typegoose/typegoose": "^13.0.0",
    "@types/express": "^5.0.6",
    "axios": "^1.6.2",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "http-status-codes": "^2.3.0",
    "inversify": "^7.10.4",
    "mongoose": "^9.0.1",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2"
  }
}
